@@ -325,3 +325,43 @@ test("playback state and resume are persisted per user", async () => {
   await request("/api/playback/state", { method: "PUT", headers: bearer(listener), body: JSON.stringify({}) });
   assert.equal((await (await request("/api/playback/state", { headers: bearer(listener) })).json()).state.trackId, null);
