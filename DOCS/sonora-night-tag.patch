+
+
+test("Studio Night tags flow through the Harmonix API and can be removed", async () => {
+  const admin = tokenFor("admin-1");
+  const listener = tokenFor("listener-1");
+  await db.run(
+    "INSERT INTO tracks (id,filename,title,artist,visibility,owner_id,genres) VALUES (?,?,?,?,?,?,?)",
+    ["night-tagged", "night.mp3", "Night Tag Contract", "Test", "public", "admin-1", "Ambient"]
+  );
+  const studioPath = "/api/studio/music/night-tagged";
+  const patch = (body, token = admin) => request(studioPath, {
+    method: "PATCH", headers: bearer(token), body: JSON.stringify(body),
+  });
+  assert.equal((await patch({ genres: "harmonix:night" }, listener)).status, 403);
+  assert.equal((await patch({ genres: { tag: "harmonix:night" } })).status, 400);
+  assert.equal((await patch({ genres: [42] })).status, 400);
+  const tagged = await patch({ genres: " Ambient ; HARMONIX:NIGHT ;Ambient; " });
+  assert.equal(tagged.status, 200);
+  assert.equal((await tagged.json()).item.genres, "Ambient;HARMONIX:NIGHT");
+  await patch({ title: "Night Tag Contract" });
+  assert.equal((await db.get("SELECT genres FROM tracks WHERE id='night-tagged'")).genres,
+    "Ambient;HARMONIX:NIGHT", "unrelated patches preserve tags");
+
+  const hx = async (path) => {
+    const response = await request(`/api/harmonix/apps/v2/catalog/${path}`, { headers: bearer(listener) });
+    assert.equal(response.status, 200);
+    return (await response.json()).data;
+  };
+  assert.equal((await hx("tracks/night-tagged")).night_eligible, true);
+  assert.equal((await hx("tracks")).find((track) => track.id === "night-tagged").night_eligible, true);
+  assert.equal((await hx("search?q=Night%20Tag%20Contract"))[0].night_eligible, true);
+  await patch({ visibility: "private" });
+  assert.equal((await request("/api/harmonix/apps/v2/catalog/tracks/night-tagged", {
+    headers: bearer(listener),
+  })).status, 404, "Night tags do not bypass track visibility");
+  await patch({ visibility: "public", genres: ["Ambient"] });
+  assert.equal((await hx("tracks/night-tagged")).night_eligible, false);
+  await patch({ genres: null });
+  assert.equal((await db.get("SELECT genres FROM tracks WHERE id='night-tagged'")).genres, "");
+});
diff --git a/core/harmonix-night.js b/core/harmonix-night.js
new file mode 100644
--- /dev/null
+++ b/core/harmonix-night.js
@@ -0,0 +1,8 @@
+// Editorial Night opt-in. A musical genre alone does not opt a track in.
+export function isHarmonixNightEligible(genres) {
+  const tags = Array.isArray(genres)
+    ? genres
+    : typeof genres === "string" ? genres.split(";") : [];
+  return tags.some((tag) => typeof tag === "string" &&
+    tag.trim().toLowerCase() === "harmonix:night");
+}
diff --git a/test/harmonix-night.test.js b/test/harmonix-night.test.js
new file mode 100644
--- /dev/null
+++ b/test/harmonix-night.test.js
@@ -0,0 +1,12 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { isHarmonixNightEligible } from "../core/harmonix-night.js";
+
+test("Night opt-in matches an exact tag, with whitespace and case normalization", () => {
+  for (const genres of ["harmonix:night", "Ambient; HARMONIX:NIGHT ;Piano", ["Lo-Fi", " harmonix:night "]]) {
+    assert.equal(isHarmonixNightEligible(genres), true);
+  }
+  for (const genres of [null, undefined, 42, [], "", "Ambient;Piano", "night", "harmonix:night-only", "prefix-harmonix:night", [null, 42, "Ambient"]]) {
+    assert.equal(isHarmonixNightEligible(genres), false);
+  }
+});
